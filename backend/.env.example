# App
APP_NAME=PharmaStock AI
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg2://pharmastock:pharmastock@localhost:5432/pharmastock

# JWT (value lives only inside HttpOnly cookie — never returned to JS)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# HttpOnly cookie session
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/

# CORS — exact origins only (required with credentials; never *)
CORS_ORIGINS=http://localhost:5173

# OCR / uploads
OCR_UPLOAD_DIR=uploads/invoices
TESSERACT_CMD=

# WhatsApp Business API (stubbed in MVP)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Drug License Verification API (stubbed in MVP)
DRUG_LICENSE_API_URL=
DRUG_LICENSE_API_KEY=

# Seed (optional local bootstrap)
SEED_ADMIN_EMAIL=admin@pharmastock.example
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
